{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist-electron",
    "skipLibCheck": true,
    "noEmit": false,
    "composite": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/electron/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.*"
  ]
}