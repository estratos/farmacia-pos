{
  "name": "farmacia-pos",
  "version": "1.0.0",
  "description": "Sistema de punto de venta para farmacias",
  "author": "Farmacia POS",
  "license": "MIT",
  "main": "dist-electron/src/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json",
    "clean": "node -e \"['dist','dist-electron','out','release'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build:all": "npm run build && npm run electron:build && npm run package",
    "dist": "npm run build && npm run electron:build && npm run make"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.14",
    "electron": "^38.2.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "extraResource": [
          "./dist"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "farmacia_pos",
            "authors": "Farmacia POS",
            "description": "Sistema de punto de venta para farmacias"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        }
      ]
    }
  }
}
